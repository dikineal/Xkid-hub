        local list = CatcherEngine:ScanAnimals()
        animalDisplayNames = {}
        for _, a in ipairs(list) do
            table.insert(animalDisplayNames, string.format("%s [%dm]", a.Name, a.Distance))
        end
        if #animalDisplayNames == 0 then table.insert(animalDisplayNames, "Hewan tidak ditemukan") end
        
        animalDropdown:Refresh(animalDisplayNames, true)
        notify("Scanner", string.format("Terdeteksi %d Hewan!", #list), 2, "check")
    end
})

local secPos = TabScan:Section({ Title = "Target Navigation & Merchant", Icon = "map-pin", Box = true })

secPos:Button({
    Title = "Dekati Hewan (Safe Distance) 📍",
    Desc = "Mendekati hewan yang dipilih tanpa auto-catch",
    Callback = function()
