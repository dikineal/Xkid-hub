-- ================================ SERVICES ================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LP = Players.LocalPlayer

-- ================================ NOTIFY HELPER ================================
local function notify(title, content, duration, icon)
    pcall(function() 
        WindUI:Notify({ Title = title, Content = content, Duration = duration or 2, Icon = icon or "bell" }) 
    end)
end

local function getLocalRoot()
    local char = LP.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Head"))
end

-- ================================ CORE SCANNER & EXPORTER ENGINE ================================
local CatcherEngine = {
    ScanRadius = 500,
    FoundAnimals = {},
    FoundUIElements = {},
    Logs = {},
    SelectedAnimal = nil
}

function CatcherEngine:AddLog(msg)
    local timestamp = os.date("%H:%M:%S")
    local entry = string.format("[%s] %s", timestamp, msg)
    table.insert(self.Logs, entry)
    if #self.Logs > 100 then table.remove(self.Logs, 1) end
end

-- 1. SCAN MAP HEWAN & INTERAKSI
function CatcherEngine:ScanAnimals()
    local root = getLocalRoot()
    if not root then return {} end

    self.FoundAnimals = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LP.Character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChild("Head")
            
            -- Filter Hewan / NPC Mini-game
            if hum and hrp and not Players:GetPlayerFromCharacter(obj) then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= self.ScanRadius then
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                    table.insert(self.FoundAnimals, {
                        Model = obj,
                        Name = obj.Name,
                        Position = hrp.Position,
                        CFrame = hrp.CFrame,
                        Distance = math.floor(dist),
                        Prompt = prompt
                    })
                end
            end
        end
    end

    table.sort(self.FoundAnimals, function(a, b) return a.Distance < b.Distance end)
    self:AddLog(string.format("Scan Selesai: %d Hewan Terdeteksi dalam Radius %dm", #self.FoundAnimals, self.ScanRadius))
    return self.FoundAnimals
end

-- 2. SCAN UI/MINIGAME ELEMENT
function CatcherEngine:ScanActiveUI()
    self.FoundUIElements = {}
    local pGui = LP:FindFirstChildOfClass("PlayerGui")
    if not pGui then return end

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled then
            for _, element in ipairs(gui:GetDescendants()) do
                if (element:IsA("ImageButton") or element:IsA("TextButton") or element:IsA("ImageLabel")) and element.Visible then
                    table.insert(self.FoundUIElements, {
                        GuiName = gui.Name,
                        Name = element.Name,
                        Class = element.ClassName,
                        Position = element.AbsolutePosition,
                        Size = element.AbsoluteSize
                    })
                end
            end
        end
    end
    self:AddLog(string.format("UI Scan: %d Elemen UI Aktif Terdeteksi", #self.FoundUIElements))
end

-- ================================ MERCHANT TELEPORT ================================
local function teleportToMerchant()
    local root = getLocalRoot()
    if not root then
        notify("Error", "Character tidak ditemukan!", 2, "alert-circle")
        return
    end

    local sellBooth = Workspace:FindFirstChild("SellBooth", true)
    if sellBooth then
        local targetCF = sellBooth:IsA("Model") and (sellBooth.PrimaryPart or sellBooth:FindFirstChildWhichIsA("BasePart")).CFrame or sellBooth.CFrame
        root.CFrame = targetCF * CFrame.new(0, 3, 3)
        CatcherEngine:AddLog("Teleport ke SellBooth via Model Target")
    else
        root.CFrame = CFrame.new(642.5, -192.0, -980.0)
        CatcherEngine:AddLog("Teleport ke SellBooth via Koordinat Presisi")
    end
    root.AssemblyLinearVelocity = Vector3.zero
    notify("Merchant TP", "Berhasil Teleport ke Penjual!", 2, "store")
end

