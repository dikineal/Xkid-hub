local animalDropdown
local animalDisplayNames = { "Belum ada hasil scan" }

animalDropdown = secScan:Dropdown({
    Title = "Pilih Hewan Terdekat",
    Values = animalDisplayNames,
    Callback = function(selected)
        for _, animal in ipairs(CatcherEngine.FoundAnimals) do
            local label = string.format("%s [%dm]", animal.Name, animal.Distance)
            if label == selected then
                CatcherEngine.SelectedAnimal = animal
                CatcherEngine:AddLog("Target Dipilih: " .. animal.Name)
                break
            end
        end
    end
})

secScan:Button({
    Title = "Scan Map Hewan Sekarang 🔍",
