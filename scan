-- ================================ CORE SCANNER & CATCHER ENGINE ================================
local Engine = {
    ScanRadius = 500,
    FoundAnimals = {},
    FoundMinigameObjs = {},
    Logs = {},
    SelectedAnimal = nil,
    AutoCatchLoop = false
}

local function getLocalRoot()
    local char = LP.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Head"))
end

function Engine:AddLog(msg)
    local timestamp = os.date("%H:%M:%S")
    local logEntry = string.format("[%s] %s", timestamp, msg)
    table.insert(self.Logs, logEntry)
    if #self.Logs > 100 then table.remove(self.Logs, 1) end
end

-- Auto Equip Jaring / Net
function Engine:EquipNet()
    local char = LP.Character
    if not char then return false end
    
    -- Cek jika jaring sudah di-equip
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("net") or item.Name:lower():find("jaring") or item.Name:lower():find("catch")) then
            return true
        end
    end
    
    -- Cari di Backpack
    local backpack = LP:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("net") or tool.Name:lower():find("jaring") or tool.Name:lower():find("catch")) then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:EquipTool(tool)
                    self:AddLog("Equipped Tool: " .. tool.Name)
                    return true
                end
            end
        end
    end
    return false
end

-- Scan Map (Hewan & Objek Mini-game)
function Engine:ScanMap()
    local root = getLocalRoot()
    if not root then return end

    self.FoundAnimals = {}
    self.FoundMinigameObjs = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LP.Character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChild("Head")
            
            -- Scan Hewan
            if hum and hrp and not Players:GetPlayerFromCharacter(obj) then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= self.ScanRadius then
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                    table.insert(self.FoundAnimals, {
                        Model = obj,
                        Name = obj.Name,
                        Position = hrp.Position,
                        CFrame = hrp.CFrame,
                        Distance = math.floor(dist),
                        Prompt = prompt
                    })
                end
            end
        elseif obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
            -- Scan Objek Interaktif Mini-Game
            local parentPart = obj.Parent
            if parentPart and parentPart:IsA("BasePart") then
                local dist = (parentPart.Position - root.Position).Magnitude
                if dist <= self.ScanRadius then
                    table.insert(self.FoundMinigameObjs, {
                        Name = parentPart.Name,
                        ClassName = obj.ClassName,
                        Position = parentPart.Position,
                        CFrame = parentPart.CFrame,
                        Distance = math.floor(dist),
                        Object = obj
                    })
                end
            end
        end
    end

    -- Sortir berdasarkan jarak
    table.sort(self.FoundAnimals, function(a, b) return a.Distance < b.Distance end)
    table.sort(self.FoundMinigameObjs, function(a, b) return a.Distance < b.Distance end)

    self:AddLog(string.format("Scan Selesai: %d Hewan, %d Objek Mini-Game.", #self.FoundAnimals, #self.FoundMinigameObjs))
end

-- Eksekusi Tangkap Hewan
function Engine:CatchAnimal(animalData)
    if not animalData or not animalData.Model then return end
    local root = getLocalRoot()
    if not root then return end

    local targetHrp = animalData.Model:FindFirstChild("HumanoidRootPart") or animalData.Model.PrimaryPart or animalData.Model:FindFirstChild("Head")
    if targetHrp then
        -- Teleport Ke Jarak Aman (2 stud di atas/belakang)
        root.CFrame = targetHrp.CFrame * CFrame.new(0, 2, 2)
        root.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.15)

        -- Equip Jaring
        self:EquipNet()
        task.wait(0.1)

        -- Eksekusi Catch
        if animalData.Prompt then
            fireproximityprompt(animalData.Prompt)
            self:AddLog("Triggered ProximityPrompt: " .. animalData.Name)
        else
            local char = LP.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                    self:AddLog("Activated Net Tool on: " .. animalData.Name)
                end
            end
        end
    end
end

