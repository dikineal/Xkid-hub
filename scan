-- ================================ SERVICES ================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LP = Players.LocalPlayer

local StealthEngine = {
    Logs = {},
    Animals = {},
    RemotesFound = {},
    UIElements = {}
}

local function notify(title, content, duration, icon)
    pcall(function() WindUI:Notify({ Title = title, Content = content, Duration = duration or 2, Icon = icon or "bell" }) end)
end

function StealthEngine:Log(msg)
    local t = os.date("%H:%M:%S")
    local entry = string.format("[%s] %s", t, msg)
    table.insert(self.Logs, entry)
    if #self.Logs > 150 then table.remove(self.Logs, 1) end
end

-- ================================ PASSIVE REMOTE SCANNER (SAFE) ================================
function StealthEngine:ScanReplicatedRemotes()
    self.RemotesFound = {}
    local count = 0

    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            count = count + 1
            table.insert(self.RemotesFound, {
                Name = obj.Name,
                Class = obj.ClassName,
                Path = obj:GetFullName()
            })
        end
    end

    self:Log(string.format("Scan Safe: Ditemukan %d RemoteEvent/RemoteFunction di ReplicatedStorage.", count))
    return count
end

-- ================================ ANIMAL SCANNER (SAFE) ================================
function StealthEngine:ScanAnimals()
    self.Animals = {}
    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LP.Character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChild("Head")

            if hum and hrp and not Players:GetPlayerFromCharacter(obj) then
                count = count + 1
                table.insert(self.Animals, {
                    Name = obj.Name,
                    Position = hrp.Position,
                    Path = obj:GetFullName()
                })
            end
        end
    end

    self:Log(string.format("Scan Map: Ditemukan total %d hewan/NPC di Workspace.", count))
    return count
end

-- ================================ UI MINIGAME SCANNER (SAFE) ================================
function StealthEngine:ScanMinigameUI()
    self.UIElements = {}
    local pGui = LP:FindFirstChildOfClass("PlayerGui")
    if not pGui then return end

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled then
            for _, btn in ipairs(gui:GetDescendants()) do
                if (btn:IsA("ImageButton") or btn:IsA("TextButton") or btn:IsA("ImageLabel")) and btn.Visible then
                    table.insert(self.UIElements, {
                        GuiName = gui.Name,
                        Name = btn.Name,
                        Class = btn.ClassName,
                        Path = btn:GetFullName()
                    })
                end
            end
        end
    end

    self:Log(string.format("UI Scan: Ditemukan %d elemen UI aktif di layar.", #self.UIElements))
end

