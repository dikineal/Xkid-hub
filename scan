-- ================================ NOTIFY HELPER ================================
local function notify(title, content, duration, icon)
    pcall(function() 
        WindUI:Notify({ Title = title, Content = content, Duration = duration or 2, Icon = icon or "bell" }) 
    end)
end

local function getLocalRoot()
    local char = LP.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Head"))
end

-- ================================ OPTIMIZED CATCH ENGINE ================================
local AutoCatchEngine = {
    Enabled = false,
    Interval = 0.1, -- 10x per detik (Sangat aman untuk baterai & CPU HP)
    RunningThread = nil
}

local function emulateTap(x, y)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.01)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

function AutoCatchEngine:Start()
    if self.RunningThread then self.RunningThread = nil end

    self.RunningThread = task.spawn(function()
        while self.Enabled do
            local playerGui = LP:FindFirstChildOfClass("PlayerGui")
            if playerGui then
                local foundTarget = false

                for _, gui in ipairs(playerGui:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui.Enabled then
                        for _, element in ipairs(gui:GetDescendants()) do
                            if (element:IsA("ImageButton") or element:IsA("TextButton") or element:IsA("ImageLabel")) and element.Visible then
                                
                                local nameLower = element.Name:lower()
                                local parentName = element.Parent and element.Parent.Name:lower() or ""
                                local isTarget = false

                                -- 1. Target Tombol Jaring & Minigame
                                if nameLower:find("net") or nameLower:find("jaring") or nameLower:find("catch") or nameLower:find("action") or nameLower:find("capung") or parentName:find("tangkap") then
                                    isTarget = true
                                end

                                -- 2. Fallback Position Check (Tombol Bawah Tengah Layar)
                                if not isTarget and element:IsA("ImageButton") and element.Image ~= "" then
                                    local pos = element.AbsolutePosition
                                    local vp = workspace.CurrentCamera.ViewportSize
                                    if pos.Y > (vp.Y * 0.55) and math.abs(pos.X - (vp.X * 0.5)) < (vp.X * 0.3) then
                                        isTarget = true
                                    end
                                end

                                -- Eksekusi Klik Presisi
                                if isTarget then
                                    foundTarget = true
                                    
                                    -- A. Internal Signal Trigger
                                    pcall(function()
                                        for _, conn in ipairs(getconnections(element.MouseButton1Click)) do conn:Fire() end
                                        for _, conn in ipairs(getconnections(element.Activated)) do conn:Fire() end
                                        for _, conn in ipairs(getconnections(element.TouchTap)) do conn:Fire() end
                                    end)

                                    -- B. Physical Tap Emulation Fallback
                                    local pos = element.AbsolutePosition
                                    local size = element.AbsoluteSize
                                    emulateTap(pos.X + (size.X / 2), pos.Y + (size.Y / 2) + 36)

                                    break
                                end
                            end
                        end
                    end
                    if foundTarget then break end
                end
            end
            task.wait(self.Interval) -- Jeda ringan agar CPU & Baterai tetap adem
        end
    end)
end

function AutoCatchEngine:Stop()
    self.Enabled = false
    self.RunningThread = nil
end

-- ================================ MERCHANT TP ENGINE ================================
local function teleportToMerchant()
    local root = getLocalRoot()
    if not root then
        notify("Error", "Character tidak ditemukan!", 2, "alert-circle")
        return
    end

    local sellBooth = Workspace:FindFirstChild("SellBooth", true)
    if sellBooth then
        local targetCF = sellBooth:IsA("Model") and (sellBooth.PrimaryPart or sellBooth:FindFirstChildWhichIsA("BasePart")).CFrame or sellBooth.CFrame
        root.CFrame = targetCF * CFrame.new(0, 3, 3)
    else
        root.CFrame = CFrame.new(642.5, -192.0, -980.0)
    end
    root.AssemblyLinearVelocity = Vector3.zero
    notify("Merchant TP", "Berhasil Teleport ke Penjual!", 2, "store")
end

