local LP = Players.LocalPlayer

-- ================================ NOTIFY HELPER ================================
local function notify(title, content, duration, icon)
    pcall(function() 
        WindUI:Notify({ Title = title, Content = content, Duration = duration or 2, Icon = icon or "bell" }) 
    end)
end

local function getLocalRoot()
    local char = LP.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Head"))
end

-- ================================ AUTO CATCH ENGINE ================================
local AutoCatchEngine = {
    Enabled = false,
    ClickDelay = 0.03,
    Conn = nil
}

local function fireClick(x, y)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.01)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

function AutoCatchEngine:Start()
    if self.Conn then self.Conn:Disconnect() end

    self.Conn = RunService.Heartbeat:Connect(function()
        if not self.Enabled then return end

        local playerGui = LP:FindFirstChildOfClass("PlayerGui")
        if not playerGui then return end

        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Enabled then
                for _, element in ipairs(gui:GetDescendants()) do
                    if (element:IsA("ImageButton") or element:IsA("TextButton") or element:IsA("ImageLabel")) and element.Visible then
                        
                        local isTarget = false
                        local nameLower = element.Name:lower()
                        local parentName = element.Parent and element.Parent.Name:lower() or ""

                        -- 1. Deteksi Tombol Jaring
                        if nameLower:find("net") or nameLower:find("jaring") or nameLower:find("catch") or nameLower:find("action") then
                            isTarget = true
                        end

                        -- 2. Deteksi Gambar Minigame (Capung/Hewan bergerak)
                        if nameLower:find("capung") or nameLower:find("animal") or parentName:find("tangkap") or parentName:find("minigame") then
                            isTarget = true
                        end

                        -- 3. Fallback Deteksi Tombol Aksi di Bagian Bawah Layar
                        if not isTarget and element:IsA("ImageButton") and element.Image ~= "" then
                            local pos = element.AbsolutePosition
                            local vp = workspace.CurrentCamera.ViewportSize
                            if pos.Y > (vp.Y * 0.5) and math.abs(pos.X - (vp.X * 0.5)) < (vp.X * 0.35) then
                                isTarget = true
                            end
                        end

                        -- Eksekusi Klik Presisi
                        if isTarget then
                            pcall(function()
                                for _, conn in ipairs(getconnections(element.MouseButton1Click)) do conn:Fire() end
                                for _, conn in ipairs(getconnections(element.Activated)) do conn:Fire() end
                                for _, conn in ipairs(getconnections(element.TouchTap)) do conn:Fire() end
                            end)

                            local pos = element.AbsolutePosition
                            local size = element.AbsoluteSize
                            fireClick(pos.X + (size.X / 2), pos.Y + (size.Y / 2) + 36)

                            task.wait(self.ClickDelay)
                            break
                        end
                    end
                end
            end
        end
    end)
end

function AutoCatchEngine:Stop()
    self.Enabled = false
    if self.Conn then
        self.Conn:Disconnect()
        self.Conn = nil
    end
end

-- ================================ MERCHANT TP ENGINE ================================
local function teleportToMerchant()
    local root = getLocalRoot()
    if not root then
        notify("Error", "Character tidak ditemukan!", 2, "alert-circle")
        return
    end

    -- Cari SellBooth di Workspace atau gunakan koordinat presisi
    local sellBooth = Workspace:FindFirstChild("SellBooth", true)
    if sellBooth then
        local targetCFrame = sellBooth:IsA("Model") and (sellBooth.PrimaryPart or sellBooth:FindFirstChildWhichIsA("BasePart")).CFrame or sellBooth.CFrame
        root.CFrame = targetCFrame * CFrame.new(0, 3, 3)
        notify("Teleport", "Teleport ke Penjual (SellBooth)", 2, "store")
    else
        -- Fallback Koordinat dari hasil scan map kamu
        root.CFrame = CFrame.new(642.5, -192.0, -980.0)
        notify("Teleport", "Teleport ke Koordinat Penjual", 2, "store")
    end
    root.AssemblyLinearVelocity = Vector3.zero
end

