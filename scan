-- ================================ CLICK FUNCTION ================================
local function fireClick(x, y)
    -- Coba VirtualInputManager dulu
    if VirtualInputManager and VirtualInputManager.SendMouseButtonEvent then
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
        return true
    end
    return false
end

-- ================================ AUTO CATCH ENGINE ================================
local function startAutoCatch()
    if State.Conn then State.Conn:Disconnect(); State.Conn = nil end

    State.Conn = task.spawn(function()
        while State.AutoCatch do
            task.wait(0.1)  -- 10x/detik, hemat CPU

            local playerGui = LP:FindFirstChildOfClass("PlayerGui")
            if not playerGui then continue end

            -- Cooldown cek
            if tick() - State.LastClickTime < State.ClickDelay then continue end

            local clicked = false
            for _, gui in ipairs(playerGui:GetChildren()) do
                if not gui:IsA("ScreenGui") or not gui.Enabled then continue end
                for _, element in ipairs(gui:GetDescendants()) do
                    if not (element:IsA("ImageButton") or element:IsA("TextButton") or element:IsA("ImageLabel")) then continue end
                    if not element.Visible then continue end

                    local isTarget = false
                    local nameLower = element.Name:lower()
                    local parentName = element.Parent and element.Parent.Name:lower() or ""

                    -- Deteksi tombol jaring
                    if nameLower:find("net") or nameLower:find("jaring") or nameLower:find("catch") or nameLower:find("action") then
                        isTarget = true
                    end

                    -- Deteksi minigame
                    if nameLower:find("capung") or nameLower:find("animal") or parentName:find("tangkap") or parentName:find("minigame") then
                        isTarget = true
                    end

                    -- Fallback: ImageButton di bawah layar
                    if not isTarget and element:IsA("ImageButton") and element.Image ~= "" then
                        local pos = element.AbsolutePosition
                        local vp = workspace.CurrentCamera.ViewportSize
                        if pos.Y > (vp.Y * 0.5) and math.abs(pos.X - (vp.X * 0.5)) < (vp.X * 0.35) then
                            isTarget = true
                        end
                    end

                    if isTarget then
                        -- Fire connections
                        pcall(function()
                            if getconnections then
                                for _, conn in ipairs(getconnections(element.MouseButton1Click)) do conn:Fire() end
                                for _, conn in ipairs(getconnections(element.Activated)) do conn:Fire() end
                                for _, conn in ipairs(getconnections(element.TouchTap)) do conn:Fire() end
                            end
                        end)

                        -- Fallback: langsung Activate
                        pcall(function()
                            if element.Activate then element:Activate() end
                        end)

                        -- Fire click di posisi
                        local pos = element.AbsolutePosition
                        local size = element.AbsoluteSize
                        fireClick(pos.X + (size.X / 2), pos.Y + (size.Y / 2) + State.ClickOffset)

                        State.ClickCount = State.ClickCount + 1
                        State.LastClickTime = tick()
                        clicked = true
                        break
                    end
                end
                if clicked then break end
            end
        end
    end)
end

local function stopAutoCatch()
    if State.Conn then
        pcall(function() task.cancel(State.Conn) end)
        State.Conn = nil
    end
end

-- ================================ MERCHANT TP ================================
local function teleportToMerchant()
    local root = getLocalRoot()
    if not root then return end

    local sellBooth = Workspace:FindFirstChild("SellBooth", true)
    if sellBooth then
        local targetPart = sellBooth:IsA("Model") and (sellBooth.PrimaryPart or sellBooth:FindFirstChildWhichIsA("BasePart")) or sellBooth
        if targetPart then
            root.CFrame = targetPart.CFrame * CFrame.new(0, 3, 3)
            root.AssemblyLinearVelocity = Vector3.zero
            State.TPCount = State.TPCount + 1
            return true
        end
    end
    -- Fallback koordinat (Hutan Voice)
    root.CFrame = CFrame.new(642.5, -192.0, -980.0)
    root.AssemblyLinearVelocity = Vector3.zero
    State.TPCount = State.TPCount + 1
    return true
end

