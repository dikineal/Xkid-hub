function Inspector:Log(msg)
    local t = os.date("%H:%M:%S")
    local entry = string.format("[%s] %s", t, msg)
    table.insert(self.Logs, entry)
    if #self.Logs > 120 then table.remove(self.Logs, 1) end
end

-- ================================ 1. REMOTE EVENT SPY ENGINE ================================
local function hookRemotes()
    local rawMeta = getrawmetatable(game)
    local oldNamecall = rawMeta.__namecall
    setreadonly(rawMeta, false)

    rawMeta.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if Inspector.SpyActive and (method == "FireServer" or method == "fireServer" or method == "InvokeServer" or method == "invokeServer") then
            local remoteName = self.Name
            local remotePath = self:GetFullName()
            
            -- Format argumen ke string
            local argStrTable = {}
            for i, v in ipairs(args) do
                table.insert(argStrTable, tostring(v))
            end
            local argFormatted = table.concat(argStrTable, ", ")

            local spyEntry = string.format("REMOTE DETECTED: %s:%s(%s)", remoteName, method, argFormatted)
            Inspector:Log("🔥 " .. spyEntry)

            table.insert(Inspector.CapturedRemotes, {
                Name = remoteName,
                Path = remotePath,
                Method = method,
                Args = args,
                FormattedCode = string.format("game.%s:%s(%s)", remotePath, method, argFormatted)
            })
        end

        return oldNamecall(self, ...)
    end)

    setreadonly(rawMeta, true)
    Inspector:Log("Remote Spy Engine Hooked successfully!")
end

pcall(hookRemotes)

-- ================================ 2. SCANNER ANIMAL & MAP ================================
function Inspector:ScanMapAnimals()
    self.DetectedAnimals = {}
    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LP.Character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChild("Head")

            if hum and hrp and not Players:GetPlayerFromCharacter(obj) then
                count = count + 1
                table.insert(self.DetectedAnimals, {
                    Name = obj.Name,
                    Model = obj,
                    Position = hrp.Position,
                    Path = obj:GetFullName()
                })
            end
        end
    end

    self:Log(string.format("Scan Map: Ditemukan total %d hewan aktif di Workspace.", count))
    return count
end

-- ================================ 3. SCANNER MINIGAME UI ================================
function Inspector:ScanMinigameUI()
    self.DetectedUI = {}
    local pGui = LP:FindFirstChildOfClass("PlayerGui")
    if not pGui then return end

    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled then
            for _, btn in ipairs(gui:GetDescendants()) do
                if (btn:IsA("ImageButton") or btn:IsA("TextButton") or btn:IsA("ImageLabel")) and btn.Visible then
                    table.insert(self.DetectedUI, {
                        GuiName = gui.Name,
                        Name = btn.Name,
                        Class = btn.ClassName,
                        Path = btn:GetFullName(),
                        Pos = btn.AbsolutePosition,
                        Size = btn.AbsoluteSize
                    })
                end
            end
        end
    end

    self:Log(string.format("UI Inspector: Ditemukan %d elemen UI aktif di layar.", #self.DetectedUI))
end

