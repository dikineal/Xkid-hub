    Default = false,
    Callback = function(v)
        Engine.AutoCatchLoop = v
        if v then
            task.spawn(function()
                while Engine.AutoCatchLoop do
                    Engine:ScanMap()
                    if #Engine.FoundAnimals > 0 then
                        for _, animal in ipairs(Engine.FoundAnimals) do
                            if not Engine.AutoCatchLoop then break end
                            Engine:CatchAnimal(animal)
                            task.wait(1.5)
                        end
                    end
                    task.wait(2)
                end
            end)
            notify("Auto Farm", "Loop Catching ON", 1.5, "play")
        else
            notify("Auto Farm", "Loop Catching OFF", 1.5, "pause")
        end
